{
  "headers": [
    {
      "source": "/feeds/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/tab-separated-values; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
