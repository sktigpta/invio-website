# ==============================================================================
# Invio Product Website - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local development.
# ==============================================================================

# Backend API Endpoint for downloading releases and dynamic platform detection
VITE_API_URL=https://api.invio.timrio.com

# Optional version override. When unset, vite.config.js injects the version from
# package.json at build time (single source of truth — keep them in sync).
# VITE_APP_VERSION=1.0.3
